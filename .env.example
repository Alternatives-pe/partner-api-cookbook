# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit real credentials.

# Your Alternatives Partner API key (request from support@alternatives.pe)
ALT_API_KEY=YOUR_API_KEY

# API base URL (override only if directed by Alternatives)
ALT_BASE_URL=https://api.altdmp.io/v3/partners
ALT_TOKEN_URL=https://api.altdmp.io/v3/token/issue/